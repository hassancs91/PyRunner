# Git (.git-private = the private overlay repo's git dir, checked out in place)
.git
.git-private
.gitignore

# Environment files (should be passed as env vars)
.env
.env.example

# IDE
.vscode
.idea
*.swp
*.swo

# Python (dockerignore patterns only match at the context root unless prefixed
# with **/ — the bare form let 23 host __pycache__ dirs into the 1.17 image)
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.Python
venv/
env/
.venv/

# Data (will be mounted as volume)
data/
*.sqlite3

# Logs
*.log

# Documentation (not needed in image)
*.md
docs/
notes.md

# Static files (collected during build)
staticfiles/

# OS files
.DS_Store
Thumbs.db

# Claude plans
.claude/

# Local dev artifacts & credentials — must never enter the image.
# (COPY . . copies gitignored files too; .gitignore does not protect the
# Docker build context, only this file does.)
client_secret.json
token.json
dist/
landing/
design-preview/
.ruff_cache/
plugins/gmail_agent/
plugins/youtube_scout/
# Private-overlay tooling (see docs/PRIVATE_OVERLAY.md) — local only.
.privateignore
private.ps1
private.sh
