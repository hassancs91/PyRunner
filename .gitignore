# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# Django
*.log
local_settings.py
db.sqlite3
staticfiles/

# Environment files (contain secrets)
.env
.env.*
*.env

# IDE/Editor
.vscode/
.idea/
.claude/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Project specific
data/
nul
# Internal docs stay local, except the public plugin author guide.
docs/*
!docs/plugins.md

# plugins/ = runtime install target AND the local workspace for private
# plugins under development (they import natively as plugins.<slug>). Keep the
# package marker + readme in the repo, ignore everything else.
plugins/*
!plugins/__init__.py
!plugins/README.md

# Built plugin zips (one place for all of them) — reproducible from the
# source dirs under plugins/ and examples/.
dist/

# Local-only UI design mockups (scratch exploration, not shipped)
design-preview/

# Separate landing site project (has its own repo)
landing/

# Google OAuth client (local dev credential — never commit)
client_secret.json
